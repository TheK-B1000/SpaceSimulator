root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,cs}]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{md,txt}]
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.ini]
indent_style = space
indent_size = 4
end_of_line = lf
